{
  "name": "blog-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:studio": "pnpm --filter @blog-app/api db:studio"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@types/pg": "^8.18.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
