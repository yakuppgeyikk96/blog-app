{
  "name": "@blog-app/api",
  "version": "1.0.0",
  "private": true,
  "description": "Blog App — Fastify REST API",
  "main": "app.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"pnpm:watch:ts\" \"pnpm:dev:start\"",
    "watch:ts": "tsc -w",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "start": "tsc && fastify start -l info dist/app.js",
    "test": "tsc && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "lint": "echo 'no lint configured yet'",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1001.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.0",
    "@repo/shared-types": "workspace:*",
    "@sinclair/typebox": "^0.34.48",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "postgres": "^3.4.8",
    "sanitize-html": "^2.17.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.8",
    "@types/sanitize-html": "^2.16.0",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2"
  }
}